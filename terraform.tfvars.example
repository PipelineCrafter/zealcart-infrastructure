# AWS Region
region = "ap-south-1"

# Project
project_name = "zealcart"

# EC2
ami_id        = "ami-xxxxxxxxxxxxxxxxx"
instance_type = "t3.micro"
key_name      = "your-keypair"

# Database
db_name           = "zealcart"
db_username       = "admin"
db_password       = "CHANGE_ME"
db_instance_class = "db.t3.micro"
engine_version    = "8.0"
multi_az          = false

# SSH Access
ssh_cidr = "0.0.0.0/0"
